# Backend
NICOKARA_DATA_DIR=./data
NICOKARA_STORAGE_DIR=../storage/jobs
NICOKARA_MAX_VIDEO_BYTES=1073741824
NICOKARA_MAX_LYRICS_BYTES=1048576
NICOKARA_MAX_PENDING_JOBS=4
NICOKARA_MAX_UPLOADS_PER_HOUR=0
NICOKARA_CLEANUP_ENABLED=true
NICOKARA_JOB_RETENTION_HOURS=24
NICOKARA_CLEANUP_INTERVAL_SECONDS=3600
NICOKARA_ALLOWED_ORIGINS=http://localhost:3200
NICOKARA_PROCESSING_ENABLED=true
NICOKARA_FFMPEG_PATH=ffmpeg
NICOKARA_FFMPEG_TIMEOUT_SECONDS=900
# Sites a job may be created from by link (subdomains included); anything else is refused
NICOKARA_VIDEO_URL_HOSTS=youtube.com,youtu.be
# Optional: borrow the login session of this browser (chrome, edge, firefox, ...)
# for videos that require a signed-in viewer. Reads that browser's
# cookies, so leave it empty unless you need it.
NICOKARA_VIDEO_COOKIES_FROM_BROWSER=
NICOKARA_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=1800
NICOKARA_VIDEO_RENDER_TIMEOUT_SECONDS=7200
NICOKARA_VIDEO_RENDER_PRESET=veryfast
NICOKARA_VIDEO_RENDER_CRF=20
NICOKARA_WHISPER_MODEL=small
NICOKARA_WHISPER_DEVICE=cpu
NICOKARA_WHISPER_COMPUTE_TYPE=int8
# Bias recognition towards the uploaded lyrics
NICOKARA_WHISPER_LYRICS_HINT=true
# Transcribe the isolated vocal stem instead of the full mix (slower, more accurate)
NICOKARA_TRANSCRIBE_VOCAL_STEM=true
# Optional: refine lyric timing with Qwen3-ForcedAligner. Point this at a Python
# interpreter that has torch and qwen-asr installed (a separate venv is fine);
# leave empty to disable. A CUDA GPU is strongly recommended.
NICOKARA_FORCED_ALIGNER_PYTHON=
NICOKARA_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
NICOKARA_FORCED_ALIGNER_DEVICE=cuda:0
NICOKARA_FORCED_ALIGNER_TIMEOUT_SECONDS=900
# Optional: isolate the vocals with a Roformer model (GPU). The clean stem is used
# for recognition and alignment, and lets the aligner see where nobody sings so
# lyrics are never timed inside an interlude. Point this at a Python interpreter
# with torch, audio-separator, onnxruntime and audioread installed (it can be the
# same one as NICOKARA_FORCED_ALIGNER_PYTHON); leave empty to disable.
NICOKARA_VOCAL_STEM_PYTHON=
NICOKARA_VOCAL_STEM_MODEL=vocals_mel_band_roformer.ckpt
NICOKARA_VOCAL_STEM_TIMEOUT_SECONDS=1800
# Optional, recommended with a GPU: align the known lyrics to the whole song with
# karatimer (https://github.com/Jerry-at-GH/karatimer) instead of recognising the
# singing first. When it succeeds, Whisper and the Qwen refinement are skipped;
# when it fails they are the fallback. Point this at a Python interpreter that has
# karatimer installed; leave empty to disable.
# NOTE: karatimer's alignment model (NextFire/mms-300m-ForcedAligner-karaoke-ja-Latn)
# is licensed CC-BY-NC-SA-4.0, i.e. for non-commercial use only.
NICOKARA_KARATIMER_PYTHON=
# cuda or cpu; empty picks CUDA when available
NICOKARA_KARATIMER_DEVICE=
NICOKARA_KARATIMER_TIMEOUT_SECONDS=1800
NICOKARA_VOCAL_REMOVAL_BACKEND=mdx
NICOKARA_VOCAL_REMOVAL_MODEL=UVR_MDXNET_KARA_2.onnx
NICOKARA_VOCAL_REMOVAL_MODEL_DIR=./data/audio-separator-models
NICOKARA_DEEPSEEK_API_KEY=
NICOKARA_DEEPSEEK_BASE_URL=https://api.deepseek.com
NICOKARA_DEEPSEEK_MODEL=deepseek-v4-flash
NICOKARA_DEEPSEEK_TIMEOUT_SECONDS=60

# Frontend (copy the next line to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1
